# ---- SchoolLive 2.0: настройки сервера ----
# Скопируйте в .env и заполните. Подробно: docs/УСТАНОВКА.md

# Домен сайта (DNS-запись A указывает на белый IP школы).
DOMAIN=live.example.ru
# Точный адрес сайта в браузере, без "/" в конце (защита входа администрации).
ALLOWED_ORIGINS=https://live.example.ru

# Хеш секретного кода администрации. Получить:
#   echo -n 'ваш-код' | docker compose run --rm -T server hash-code
# Вставьте строку целиком, в одинарных кавычках (в хеше есть символ $).
ADMIN_CODE_HASH='$argon2id$v=19$m=19456,t=2,p=1$ЗАМЕНИТЕ$ЗАМЕНИТЕ'

# IP этого сервера в школьной сети (интерфейс, на который приходит видео).
# Если не указать, определится автоматически (не сработает при VPN).
MEDIA_LAN_IP=192.168.1.10
# Белый (внешний) IP школы, если сервер стоит за роутером с пробросом портов.
MEDIA_PUBLIC_IP=
# Порт WebRTC: пробросить на роутере UDP и TCP.
MEDIA_PORT=8189

# Сколько исходящего интернет-канала можно отдать зрителям вне школы, Мбит/с.
# Рекомендуется ~70% реальной исходящей скорости. Зрители в школьной сети не учитываются.
EGRESS_LIMIT_MBPS=200
# Сколько секунд эфир ждёт возвращения телефона после обрыва связи.
RECONNECT_GRACE_SECS=60
# Сколько зрителей могут смотреть одновременно с одного внешнего IP (защита от перегрузки).
# Адреса школьной сети не ограничиваются. 0 — без лимита.
# Сервер на VPS: все зрители из школы приходят с одного IP школы, поставьте 0.
MAX_VIEWERS_PER_IP=20

# Режим Caddy: Caddyfile — публичный домен; Caddyfile.local — HTTPS по IP внутри школы.
CADDYFILE=Caddyfile
# Только для Caddyfile.local: IP сервера, по которому его открывают в школьной сети.
LOCAL_HTTPS_HOST=192.168.1.10
